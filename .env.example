PORT=8000
# Use the exact connection string supplied by MongoDB Atlas or a local MongoDB server.
# Both MONGODB_URI and the original MONGODB_URL name are supported.
MONGODB_URI=mongodb://127.0.0.1:27017
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional for a frontend hosted at another origin. Same-origin needs no setting.
CORS_ORIGIN=
NODE_ENV=development
